# ZSH ALIAS 

if command -v duf &> /dev/null; then
  alias df="duf"
fi



if command -v eza &> /dev/null; then
  alias ls="eza --icons=auto"
  alias ll="eza --icons=auto --git -h -H -l"
elif command -v lsd &> /dev/null; then
  alias ls="lsd"
  alias ll="lsd -l -h -a"
else
  alias ls="ls --color=auto"
  alias ll="ls -alF --color=auto"
fi

if command -v nvim &> /dev/null; then
  alias vim="nvim"
  alias v="nvim"

  export EDITOR=nvim visudo
  export VISUAL=nvim visudo
  export SUDO_EDITOR=nvim
  export FCEDIT=nvim
fi

if command -v rg &> /dev/null; then
  alias grep="rg"
fi

if command -v bat &> /dev/null; then
  alias cat="bat"
fi

if command -v dust &> /dev/null; then
  alias du="dust"
fi

if command -v trash &> /dev/null; then
  alias rm_real="rm"
  alias rm='trash'
fi
# zellij
if command -v zellij &> /dev/null; then
  alias zij="zellij"
  alias zija='zellij attach'
  alias zijk='zellij kill-session'
  alias zijka='zellij kill-all-sessions'
  alias zijl='zellij list-sessions'
fi

# tmux 
if command -v tmux &> /dev/null; then
  alias tx="tmux"
  alias txa="tmux attach -t"
  alias txk="tmux kill-session -t"
  alias txka="tmux kill-session -a"
  alias txl="tmux list-session"
fi


# git
if command -v git &> /dev/null; then
  alias git-log="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit "
  alias git-commit="git commit -m"
  alias git-add="git add -A"
fi


# kitty
#
if command -v kitten &> /dev/null; then
  alias icat="kitten icat"
  alias kssh="kitten ssh"
  alias kdiff="kitten diff"
  export TERMINAL=kitty
fi
