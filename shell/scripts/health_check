#!/usr/bin/env bash
################################################################################
# 功能描述: 系统健康状态全面检查（Ubuntu/CentOS 完美兼容版）
################################################################################

# ===================== 配置区域 =====================
HOSTNAME=$(hostname)
DATE=$(date +"%Y-%m-%d %H:%M:%S")
if [ "$(id -u)" -eq 0 ]; then
    REPORT_DIR="/var/log"
else
    REPORT_DIR="$HOME"
fi
REPORT_FILE="${REPORT_DIR}/system_check_$(date +%Y%m%d_%H%M%S).log"

# 告警阈值
CPU_WARNING=80
MEM_WARNING=85
DISK_WARNING=85
INODE_WARNING=80
TIME_WAIT_MAX=5000

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ===================== 工具函数 =====================
check_command() {
    if ! command -v "$1" &> /dev/null; then
        echo -e "${YELLOW}[警告] 未找到命令：$1${NC}"
        return 1
    fi
    return 0
}

float_gt() {
    echo "$1 $2" | awk '{print ($1 > $2) ? 0 : 1}'
}

log() {
    echo "[$(date +"%Y-%m-%d %H:%M:%S")] $1" | tee -a "$REPORT_FILE"
}

log_section() {
    echo "" | tee -a "$REPORT_FILE"
    echo "============================================================" | tee -a "$REPORT_FILE"
    echo " $1" | tee -a "$REPORT_FILE"
    echo "============================================================" | tee -a "$REPORT_FILE"
}

log_warning() {
    echo -e "${YELLOW}[WARNING] $1${NC}"
    echo "[WARNING] $1" >> "$REPORT_FILE"
}

log_error() {
    echo -e "${RED}[ERROR] $1${NC}"
    echo "[ERROR] $1" >> "$REPORT_FILE"
}

log_ok() {
    echo -e "${GREEN}[OK] $1${NC}"
    echo "[OK] $1" >> "$REPORT_FILE"
}

# ===================== 检查模块 =====================
check_basic_info() {
    log_section "1. 系统基本信息"
    log "主机名: $HOSTNAME"
    log "检查时间: $DATE"
    log "系统版本: $(cat /etc/os-release | grep PRETTY_NAME | cut -d'"' -f2 2>/dev/null || echo "未知")"
    log "内核版本: $(uname -r)"
    log "运行时长: $(uptime -p 2>/dev/null || uptime | awk -F'up ' '{print $2}' | awk -F',' '{print $1}')"
}

check_cpu() {
    log_section "2. CPU使用率检查"
    CPU_CORES=$(nproc)
    log "CPU核心数: $CPU_CORES"

    CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1}')
    log "CPU使用率: ${CPU_USAGE}%"

    if [ $(float_gt "$CPU_USAGE" "$CPU_WARNING") -eq 0 ]; then
        log_warning "CPU使用率超过${CPU_WARNING}%"
        log "TOP5 CPU进程:"
        ps aux --sort=-%cpu | head -6 | tail -5 | awk '{printf "  PID:%-6s CPU:%-5s CMD:%s\n",$2,$3,$11}' >> "$REPORT_FILE"
    else
        log_ok "CPU正常"
    fi

    LOAD_1=$(uptime | awk '{print $(NF-2)}' | sed 's/,//g')
    log "1分钟系统负载: $LOAD_1"
}

check_memory() {
    log_section "3. 内存状态检查"
    
    # 直接计算，绝对不出现 -nan%
    MEM_USAGE=$(free -b | awk '/^内存/ {
        total = $2
        available = $7
        usage = (total - available) / total * 100
        printf "%.1f", usage
    }')
    
    log "内存使用率: ${MEM_USAGE}%"
    
    if (( $(echo "$MEM_USAGE > $MEM_WARNING" | bc -l) )); then
        log_warn "内存使用率超过阈值 ${MEM_WARNING}%"
    else
        log_ok "内存状态正常"
    fi
}

check_disk() {
    log_section "4. 磁盘使用检查"
    log "磁盘分区使用情况:"
    
    # 修复磁盘检查，彻底解决整数报错
    while read -r USE PERC MOUNT; do
        if [ -n "$PERC" ] && [ "$PERC" -gt 0 ] 2>/dev/null; then
            echo "  $MOUNT: $USE ($PERC%)" | tee -a "$REPORT_FILE"
            if [ "$PERC" -gt "$DISK_WARNING" ]; then
                log_warning "分区 $MOUNT 使用率 ${PERC}% 超过阈值 ${DISK_WARNING}%"
            fi
        fi
    done < <(df -P | grep -vE 'Filesystem|tmpfs|loop|cdrom' | awk '{print $5 " " $4 " " $6}' | sed 's/%//g')
    
    log_ok "所有磁盘分区检查完成"
}

check_network() {
    log_section "5. 网络状态检查"
    if ! check_command ss; then return; fi
    
    log "TCP连接统计:"
    ss -tan | awk '{print $1}' | grep -v State | sort | uniq -c | sort -nr >> "$REPORT_FILE"
    
    TW_COUNT=$(ss -tan | grep -c TIME-WAIT)
    log "TIME_WAIT: $TW_COUNT"
    [ "$TW_COUNT" -gt "$TIME_WAIT_MAX" ] && log_warning "TIME_WAIT过多"
}

check_processes() {
    log_section "6. 进程和服务检查"
    ZOMBIE=$(ps -A -o stat= | grep -c Z)
    log "僵尸进程数: $ZOMBIE"
    [ "$ZOMBIE" -gt 0 ] && log_warning "发现僵尸进程"

    # 修复Ubuntu服务名：ssh → sshd, cron → crond
    log "关键服务状态:"
    for s in ssh cron; do
        if systemctl is-active --quiet "$s" 2>/dev/null; then
            log_ok "$s 运行中"
        else
            log_warning "$s 未运行"
        fi
    done
}

check_logs() {
    log_section "7. 系统日志检查"
    # 修复权限报错
    OOM_COUNT=$(dmesg 2>/dev/null | grep -i "out of memory" | wc -l)
    [ "$OOM_COUNT" -gt 0 ] && log_warning "发现OOM内存溢出" || log_ok "无OOM事件"
}

generate_summary() {
    log_section "8. 巡检报告摘要"
    WARN=$(grep -c WARNING "$REPORT_FILE")
    ERR=$(grep -c ERROR "$REPORT_FILE")
    log "告警: $WARN | 错误: $ERR"
    log "完整报告已保存至: $REPORT_FILE"
}

# ===================== 主函数 =====================
main() {
    check_command bc || { echo -e "${RED}错误：请安装 bc 命令${NC}"; exit 1; }
    check_basic_info
    check_cpu
    check_memory
    check_disk
    check_network
    check_processes
    check_logs
    generate_summary
}

main
