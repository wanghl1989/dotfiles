if command -v trash &> /dev/null; then
  alias rm_real="rm"
  alias rm='trash'
fi

# zellij
if command -v zellij &> /dev/null; then
  alias zij="zellij"
  alias zija='zellij attach'
  alias zijk='zellij kill-session'
  alias zijka='zellij kill-all-sessions'
  alias zijl='zellij list-sessions'
fi

# tmux 
if command -v tmux &> /dev/null; then
  alias tl="tmux list-session"
  alias ts="tmux source-file ~/.config/tmux/tmux.conf"
  alias ta="tmux attach -t"
  alias tk="tmux kill-session -t"
  alias tn="tmux new -s"
fi


# git
if command -v git &> /dev/null; then
  alias gl="git pull"
  alias gp="git push"
  alias glg="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit "
  alias gc="git commit -m"
  alias ga="git add"
fi




if command -v lazygit &> /dev/null; then
  alias lzg="lazygit"
fi

if command -v lazydocker &> /dev/null; then
  alias lzd="lazydocker"
fi
# kitty
if command -v kitten &> /dev/null; then
  alias icat="kitten icat"
  alias kssh="kitten ssh"
  alias kdiff="kitten diff"
  export TERMINAL=kitty
fi


# python
alias vat="source .venv/bin/activate" # source python venv


os_kernel=$(uname -s)
# source engine
search_engine() {
    if command -v microsoft-edge &> /dev/null; then
      if [ -z "$1" ] || [ -z "$2" ]; then
          echo "请提供搜索引擎和关键词！"
          echo "用法：search_engine <baidu/bing/google/github> 关键词"
          return 1
      fi

      engine=$1
      keyword=$2
      encoded_keyword=$(python -c "import urllib.parse; print(urllib.parse.quote('$keyword'))")
      url=""

      case $engine in
          "baidu")
              url="https://www.baidu.com/s?wd=$encoded_keyword"
              ;;
          "bing")
              url="https://www.bing.com/search?q=$encoded_keyword"
              ;;
          "google")
              url="https://www.google.com/search?q=$encoded_keyword"
              ;;
          "github")
              url="https://github.com/search?q=$encoded_keyword"
              ;;
          *)
              echo "不支持的搜索引擎！支持的搜索引擎：baidu、bing、google、github"
              return 1
              ;;
      esac

      if [ "$os_kernel" = "Darwin" ]; then
        open -a "Microsoft Edge" "$url" > /dev/null 2>&1 &
      else
        microsoft-edge "$url" > /dev/null 2>&1 &
      fi
    fi


}



alias baidu="search_engine baidu"
alias bing="search_engine bing"
alias google="search_engine google"
alias github="search_engine github"

export PATH=$PATH:"$HOME/.shell/scripts"
